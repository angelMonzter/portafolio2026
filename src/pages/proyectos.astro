---
import Layout from "../layouts/Layout.astro";
import proyecto1 from "../assets/img/proyecto1.png";
import proyecto2 from "../assets/img/proyecto2.png";
import proyecto3 from "../assets/img/proyecto3.png";
import proyecto4 from "../assets/img/proyecto4.png";
import proyecto5 from "../assets/img/proyecto5.png";
import proyecto6 from "../assets/img/proyecto6.png";
---

<Layout title={"proyectos"}>
  <main class="">
    <section class="banner banner_general">
      <div class="banner_content grid-container">
        <h1 class="text-center">/ Proyectos</h1>
      </div>
    </section>

    <section class="proyectos">
      <div class="grid-container" data-aos="fade-up">
        <div class="text-center">
          <h3>Experiencias de desarrollo</h3>
        </div>
        <div class="grid-x grid-margin-x">
          <div class="cell small-4 proyecto_card">
            <div>
              <img src={proyecto1.src} />
            </div>
            <div class="content_card">
              <h5>App Escolar</h5>
              <p>
                Aplicación escolar, una plataforma completa que incluye página
                web, sistema administrable para escuelas otro para padres y uno
                más para administradores, complementado con una app móvil para
                android e ios
              </p>
              <ul>
                <li>React Native</li>
                <li>PHP</li>
                <li>MYSQL</li>
              </ul>
            </div>
            <div class="footer_card">
              <a href={`/proyectos/app-escolar`} class="detalles">
                Ver Detalles
                <i class="fa-solid fa-arrow-right"></i>
              </a>
